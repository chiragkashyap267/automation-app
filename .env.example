# ─────────────────────────────────────────────────────────────
# Two stages, two different jobs.
#
#   READING job posts  — needs vision (screenshots). Gemini or Claude.
#   WRITING the email  — text only. Groq, Claude, or Gemini.
#
# Reader: ANTHROPIC_API_KEY if set, else Gemini.
# Writer: Groq if set, else Claude, else Gemini.
# ─────────────────────────────────────────────────────────────

# FREE reader — Gemini. Keys: https://aistudio.google.com/apikey
# Fill as many slots as you have; they rotate, and a key that hits its
# limit is benched until it recovers. Empty slots are ignored and
# duplicates are counted once.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=

# FREE writer — Groq. Keys: https://console.groq.com/keys
# Much faster than Gemini for this stage, and a separate quota, so the
# two stages stop competing for the same limit. Also rotates.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# PAID, both stages — Claude. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Optional overrides ───
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-opus-5

# ─────────────────────────────────────────────────────────────
# Telegram bot (optional) — forward a JD to your bot, get an
# email back with a Send button. See README → Telegram bot.
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Any random string; Telegram echoes it back so only it can post here.
TELEGRAM_WEBHOOK_SECRET=
# Your own chat id. Without this the bot answers nobody.
TELEGRAM_ALLOWED_CHAT_ID=

# The bot sends server-side, so it needs its own copy of the credentials
# the browser normally holds.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: a public URL to your resume PDF, attached to bot-sent mail.
RESUME_URL=
RESUME_FILENAME=

# FREE writer — Cerebras. Keys: https://cloud.cerebras.ai
# Third free writer, fastest of the three. Text only, like Groq.
CEREBRAS_API_KEY_1=
CEREBRAS_API_KEY_2=

# Order the writers are tried in, e.g. "gemini,groq". Anything left out still
# acts as a fallback. Leave blank for the default: groq, cerebras, claude, gemini.
WRITER_ORDER=

# ─── Batching for the Telegram bot (optional) ───
# Lets the bot collect several screenshots into one batch with a single
# "Send all" button, and count a day's sending server-side.
# Free, no card: https://console.upstash.com → create a Redis database →
# "REST API" tab → copy both values.
# Without these the bot still works, one Send button per draft.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Weekday follow-up check (optional) ───
# A Vercel cron hits /api/cron/followups each weekday morning, looks for
# applications that have had no reply for a week, and offers in Telegram to
# nudge them. It never sends on its own — you tap the button.
# Needs the Upstash pair above: without it there is no record of what was sent.
# Set this to any long random string and Vercel signs the scheduled call with
# it. Without it the endpoint is open, though it can still only ask, not send.
CRON_SECRET=

# ─── Resume storage — Cloudinary (optional) ───
# Without this the PDF you upload in the web app is kept in Upstash as
# base64, which works but caps the file at about 650 KB: Upstash carries the
# whole command in one request, so a bigger file fails the request itself.
# With Cloudinary the bytes go there and Upstash keeps only a pointer, and
# the cap becomes the upload request (about a 4 MB PDF).
# Free, no card: https://cloudinary.com → Dashboard → "API Keys".
# Either give the single URL Cloudinary shows you:
CLOUDINARY_URL=
# …or the three parts separately. The URL above wins if both are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Where resumes are filed on the account. Defaults to
# jdmailer/resumes.
CLOUDINARY_FOLDER=
# Uploads are signed here on the server, so the secret never reaches the
# browser and no unsigned upload preset needs to exist on the account.
# Files are stored as "raw" rather than as images, because Cloudinary
# treats a PDF as an image and new accounts ship with PDF delivery for
# images blocked — the upload succeeds and the link then returns 401.
# The link carries random bytes in its name so it cannot be guessed. It is
# still readable by anyone who has it, which is what lets mail carry it.

# ─── Role-specific resumes (optional) ───
# RESUME_URL above is the default. Add RESUME_URL_<KEYWORD> variants and the
# one whose keyword appears in the role is used instead — so a QA application
# carries the QA resume. Underscores stand in for spaces, and the longest
# matching keyword wins.
#   RESUME_URL_QA=https://.../qa.pdf
#   RESUME_URL_DATA_ENGINEER=https://.../data.pdf
# The attachment is named for you and the role either way, because a folder
# of files called resume.pdf helps nobody.
