# ─────────────────────────────────────────────────────────────
# Two stages, two different jobs.
#
#   READING job posts  — needs vision (screenshots). Gemini or Claude.
#   WRITING the email  — text only. Groq, Claude, or Gemini.
#
# Reader: ANTHROPIC_API_KEY if set, else Gemini.
# Writer: Groq if set, else Claude, else Gemini.
# ─────────────────────────────────────────────────────────────

# FREE reader — Gemini. Keys: https://aistudio.google.com/apikey
# Fill as many slots as you have; they rotate, and a key that hits its
# limit is benched until it recovers. Empty slots are ignored and
# duplicates are counted once.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=

# FREE writer — Groq. Keys: https://console.groq.com/keys
# Much faster than Gemini for this stage, and a separate quota, so the
# two stages stop competing for the same limit. Also rotates.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# PAID, both stages — Claude. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Optional overrides ───
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-opus-5

# ─────────────────────────────────────────────────────────────
# Telegram bot (optional) — forward a JD to your bot, get an
# email back with a Send button. See README → Telegram bot.
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Any random string; Telegram echoes it back so only it can post here.
TELEGRAM_WEBHOOK_SECRET=
# Your own chat id. Without this the bot answers nobody.
TELEGRAM_ALLOWED_CHAT_ID=

# The bot sends server-side, so it needs its own copy of the credentials
# the browser normally holds.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: a public URL to your resume PDF, attached to bot-sent mail.
RESUME_URL=
RESUME_FILENAME=
