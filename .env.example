# ─────────────────────────────────────────────────────────────
# Two stages, two different jobs.
#
#   READING job posts  — needs vision (screenshots). Gemini or Claude.
#   WRITING the email  — text only. Groq, Claude, or Gemini.
#
# Reader: ANTHROPIC_API_KEY if set, else Gemini.
# Writer: Groq if set, else Claude, else Gemini.
# ─────────────────────────────────────────────────────────────

# FREE reader — Gemini. Keys: https://aistudio.google.com/apikey
# Fill as many slots as you have; they rotate, and a key that hits its
# limit is benched until it recovers. Empty slots are ignored and
# duplicates are counted once.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=

# FREE writer — Groq. Keys: https://console.groq.com/keys
# Much faster than Gemini for this stage, and a separate quota, so the
# two stages stop competing for the same limit. Also rotates.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# PAID, both stages — Claude. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Optional overrides ───
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-opus-5

# ─────────────────────────────────────────────────────────────
# Telegram bot (optional) — forward a JD to your bot, get an
# email back with a Send button. See README → Telegram bot.
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Any random string; Telegram echoes it back so only it can post here.
TELEGRAM_WEBHOOK_SECRET=
# Your own chat id. Without this the bot answers nobody.
TELEGRAM_ALLOWED_CHAT_ID=

# The bot sends server-side, so it needs its own copy of the credentials
# the browser normally holds.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: a public URL to your resume PDF, attached to bot-sent mail.
RESUME_URL=
RESUME_FILENAME=

# FREE writer — Cerebras. Keys: https://cloud.cerebras.ai
# Third free writer, fastest of the three. Text only, like Groq.
CEREBRAS_API_KEY_1=
CEREBRAS_API_KEY_2=

# Order the writers are tried in, e.g. "gemini,groq". Anything left out still
# acts as a fallback. Leave blank for the default: groq, cerebras, claude, gemini.
WRITER_ORDER=

# ─── Batching for the Telegram bot (optional) ───
# Lets the bot collect several screenshots into one batch with a single
# "Send all" button, and count a day's sending server-side.
# Free, no card: https://console.upstash.com → create a Redis database →
# "REST API" tab → copy both values.
# Without these the bot still works, one Send button per draft.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Weekday follow-up check (optional) ───
# A Vercel cron hits /api/cron/followups each weekday morning, looks for
# applications that have had no reply for a week, and offers in Telegram to
# nudge them. It never sends on its own — you tap the button.
# Needs the Upstash pair above: without it there is no record of what was sent.
# Set this to any long random string and Vercel signs the scheduled call with
# it. Without it the endpoint is open, though it can still only ask, not send.
CRON_SECRET=
